    "It will be removed from any recipes that use it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم إزالته من أي وصفات تستخدمه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird aus allen Rezepten entfernt, die es verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminará de cualquier receta que lo use."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il sera retiré de toutes les recettes qui l'utilisent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrà rimosso da qualsiasi ricetta che lo utilizza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用されているレシピから削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용 중인 레시피에서 제거됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het zal worden verwijderd uit alle recepten die het gebruiken."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Será removido de qualquer receita que o use."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bude odstránené z akýchkoľvek receptov, ktoré ho používajú."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den kommer att tas bort från alla recept som använder den."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Він буде видалений з будь-яких рецептів, які його використовують."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它将从使用它的任何食谱中移除。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det vil blive fjernet fra alle opskrifter, der bruger det."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostanie usunięty z przepisów, które go używają."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanıldığı tariflerden kaldırılacak."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Va fi eliminat din orice rețetă care îl folosește."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Eltávolításra kerül minden receptből, amely használja."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
