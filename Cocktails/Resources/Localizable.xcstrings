    "IBA Unforgettables" : {
      "comment" : "Recipe source — IBA classic cocktails",
      "shouldTranslate" : false
    },
    "IBA Unforgettables are a curated list of timeless, classic cocktail recipes established by the International Bartenders Association." : {
      "comment" : "Recipe source description — IBA Unforgettables",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IBA Unforgettables هي قائمة مختارة من وصفات الكوكتيل الكلاسيكية الخالدة التي أنشأتها جمعية السقاة الدولية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IBA Unforgettables sind eine kuratierte Liste zeitloser, klassischer Cocktailrezepte, erstellt von der International Bartenders Association."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IBA Unforgettables son una lista seleccionada de recetas de cócteles clásicos y atemporales establecida por la Asociación Internacional de Bartenders."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les IBA Unforgettables sont une liste de recettes de cocktails classiques et intemporelles établie par l'International Bartenders Association."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli IBA Unforgettables sono una lista curata di ricette di cocktail classici e senza tempo stabilita dall'International Bartenders Association."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IBA Unforgettablesは、国際バーテンダー協会によって確立された、時代を超えたクラシックなカクテルレシピの厳選リストです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IBA Unforgettables는 국제 바텐더 협회가 선정한 시대를 초월한 클래식 칵테일 레시피 목록이야."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IBA Unforgettables zijn een samengestelde lijst van tijdloze, klassieke cocktailrecepten opgesteld door de International Bartenders Association."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IBA Unforgettables são uma lista selecionada de receitas de coquetéis clássicos e atemporais estabelecida pela International Bartenders Association."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IBA Unforgettables sú vybraný zoznam nadčasových, klasických koktailových receptov vytvorený Medzinárodnou asociáciou barmanov."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IBA Unforgettables är en utvald lista över tidlösa, klassiska cocktailrecept etablerade av International Bartenders Association."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IBA Unforgettables — це добірка вічних класичних коктейлів, встановлена Міжнародною асоціацією барменів."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
