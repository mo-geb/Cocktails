          "stringUnit": {
            "state": "translated",
            "value": "Paie une fois, à toi pour toujours — pas d'abonnement"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Paga una volta, tuo per sempre — nessun abbonamento"
