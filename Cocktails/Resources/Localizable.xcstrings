    "Pay once, yours forever — no subscription": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ادفع مرة واحدة، لك للأبد — بدون اشتراك"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmal zahlen, für immer deins — kein Abo"
