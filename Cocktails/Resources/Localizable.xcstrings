        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度購入すればずっと使える — サブスクリプションなし"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번 결제, 영원히 내 것 — 구독 없음"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Betaal eenmaal, voor altijd van jou — geen abonnement"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pague uma vez, é seu para sempre — sem assinatura"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaplať raz, tvoje navždy — bez predplatného"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Betala en gång, din för alltid — ingen prenumeration"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Заплати раз, твоє назавжди — без підписки"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次付费，永久拥有——无订阅"
