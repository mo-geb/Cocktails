    "Tap + to add ingredients to your bar.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط + لإضافة مكونات إلى بارك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf +, um Zutaten zu deiner Bar hinzuzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca + para añadir ingredientes a tu bar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuie sur + pour ajouter des ingrédients à ton bar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca + per aggiungere ingredienti al tuo bar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "+をタップしてバーに材料を追加。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "+를 눌러 바에 재료를 추가하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op + om ingrediënten aan je bar toe te voegen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque + para adicionar ingredientes ao seu bar."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ťukni na + a pridaj ingrediencie do svojho baru."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på + för att lägga till ingredienser i din bar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисни +, щоб додати інгредієнти в свій бар."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击 + 添加配料到你的酒吧。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på + for at tilføje ingredienser til din bar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij +, aby dodać składniki do swojego baru."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara malzeme eklemek için + simgesine dokun."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge + pentru a adăuga ingrediente în barul tău."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints a + jelre, hogy hozzávalókat adj a bárhoz."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點擊 + 將食材添加到你的酒吧。"
          }
        }
      }
    },
