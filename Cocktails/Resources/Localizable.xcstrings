    "You've reached the free limit of %lld cocktails. Upgrade once to save as many as you like.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد وصلت إلى الحد المجاني من %lld كوكتيل. قم بالترقية مرة واحدة لحفظ ما تشاء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast das kostenlose Limit von %lld Cocktails erreicht. Upgrade einmalig, um so viele zu speichern, wie du möchtest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has alcanzado el límite gratuito de %lld cócteles. Mejora una vez para guardar tantos como quieras."
          }
        },
        "fr": {
          "stringUnit": {
