    "Stock ingredients in your inventory to see cocktails you can make." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خزن المكونات في مخزونك لترى الكوكتيلات التي يمكنك صنعها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lagere Zutaten in deinem Inventar, um Cocktails zu sehen, die du mixen kannst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Almacena ingredientes en tu inventario para ver los cócteles que puedes hacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stocke des ingrédients dans ton inventaire pour voir les cocktails que tu peux préparer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi ingredienti al tuo inventario per vedere i cocktail che puoi fare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在庫に材料を登録して作れるカクテルを確認しよう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "재고에 재료를 추가하여 만들 수 있는 칵테일을 확인하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voorraad ingrediënten in je inventaris om cocktails te zien die je kunt maken."
